---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	architect(architect)
	backend(backend)
	frontend(frontend)
	critic(critic)
	__end__([<p>__end__</p>]):::last
	__start__ --> architect;
	architect --> backend;
	backend -.-> critic;
	backend -.-> frontend;
	critic -.-> __end__;
	critic -.-> backend;
	critic -.-> frontend;
	frontend --> critic;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
