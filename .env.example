# ---------------------------------------------------------------------------
# swarm-showcase — copy to `.env` (loaded by direnv via `dotenv_if_exists`).
# ---------------------------------------------------------------------------

# --- Provider credentials (only the ones your role routing needs) ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Role routing: provider ∈ {anthropic, openai, openrouter, ollama} ------
# Node 1 — Orchestrator / Architect (Claude)
SWARM_ARCHITECT__PROVIDER=anthropic
SWARM_ARCHITECT__MODEL=claude-opus-5-5

# Node 2 — Backend Engineer
SWARM_BACKEND__PROVIDER=anthropic
SWARM_BACKEND__MODEL=claude-sonnet-5

# Node 3 — Frontend Engineer
SWARM_FRONTEND__PROVIDER=anthropic
SWARM_FRONTEND__MODEL=claude-sonnet-5

# Node 4 — "Pan Maruda", adversarial critic (independent model family!)
SWARM_CRITIC__PROVIDER=openai
SWARM_CRITIC__MODEL=gpt-4o
# Via OpenRouter instead:
# SWARM_CRITIC__PROVIDER=openrouter
# SWARM_CRITIC__MODEL=openai/gpt-4o

# --- Local fallback for the engineer nodes ---------------------------------
# When enabled, a failing primary engineer model transparently falls back to Ollama.
SWARM_OLLAMA_FALLBACK_ENABLED=true
SWARM_OLLAMA_FALLBACK_MODEL=llama3.1:8b

# --- Loop control ----------------------------------------------------------
SWARM_MAX_ITERATIONS=3
SWARM_ACCEPTANCE_THRESHOLD=80
SWARM_TEMPERATURE=0.2

# --- Langfuse tracing (tracing is skipped when keys are empty) -------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
