# =============================================================================
# swarm-showcase — environment template
# -----------------------------------------------------------------------------
#   cp .env.example .env && chmod 600 .env
#
# WHERE SECRETS LIVE: only in `.env` at the project root, on the external SSD.
#   - `.env` is git-ignored (verify: `git check-ignore -v .env`).
#   - Loaded by direnv (`dotenv_if_exists .env`) and by pydantic-settings,
#     scoped to this directory — never export keys from ~/.zshrc or ~/.zprofile.
#   - Leave a key empty if its provider isn't used; the app fails fast only
#     when a role actually routed to that provider is missing its key.
# =============================================================================

# --- Provider credentials ----------------------------------------------------
# Anthropic — needed by any role with PROVIDER=anthropic (default: architect,
# backend, frontend). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — needed by any role with PROVIDER=openai (default: critic).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter — only if a role uses PROVIDER=openrouter (e.g. the critic via
# `openai/gpt-4o`). https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama — local, no key. Used for the engineer fallback / fully local runs.
OLLAMA_BASE_URL=http://localhost:11434

# --- Role routing: provider ∈ {anthropic, openai, openrouter, ollama} ----------
# Node 1 — Orchestrator / Architect (Claude)
SWARM_ARCHITECT__PROVIDER=anthropic
SWARM_ARCHITECT__MODEL=claude-opus-5-5

# Node 2 — Backend Engineer
SWARM_BACKEND__PROVIDER=anthropic
SWARM_BACKEND__MODEL=claude-sonnet-5

# Node 3 — Frontend Engineer
SWARM_FRONTEND__PROVIDER=anthropic
SWARM_FRONTEND__MODEL=claude-sonnet-5

# Node 4 — "Pan Maruda", adversarial critic. Keep it on a DIFFERENT model family
# than the engineers so reviewer and author don't share blind spots.
SWARM_CRITIC__PROVIDER=openai
SWARM_CRITIC__MODEL=gpt-4o
# Via OpenRouter instead:
# SWARM_CRITIC__PROVIDER=openrouter
# SWARM_CRITIC__MODEL=openai/gpt-4o

# --- Local fallback for the engineer nodes -------------------------------------
# A failing (or key-less) primary engineer model falls back to local Ollama.
SWARM_OLLAMA_FALLBACK_ENABLED=true
SWARM_OLLAMA_FALLBACK_MODEL=llama3.1:8b

# --- Loop control ----------------------------------------------------------------
SWARM_MAX_ITERATIONS=3          # self-correction budget (revisions after the first pass)
SWARM_ACCEPTANCE_THRESHOLD=80   # critic score required for acceptance (0-100)
SWARM_TEMPERATURE=0.2

# --- Langfuse tracing ------------------------------------------------------------
# Tracing is enabled only when BOTH keys are set. Project → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud (default) · US: https://us.cloud.langfuse.com · or your self-hosted URL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
