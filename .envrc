# --------------------------------------------------------------------------- #
# direnv configuration — storage hygiene for an external-volume workspace.
#
# Every artefact (virtualenv, uv cache, uv-managed CPython, tool caches,
# tempfiles) is pinned INSIDE this project directory, so nothing leaks onto the
# host's internal disk (~/.cache, ~/.local, ~/Library/Caches, /var/folders).
#
# Activate once per machine:   direnv allow .
# --------------------------------------------------------------------------- #

export PROJECT_ROOT="$PWD"

# ----------------------------- uv / virtualenv ------------------------------ #
export UV_PROJECT_ENVIRONMENT="$PROJECT_ROOT/.venv"
export UV_CACHE_DIR="$PROJECT_ROOT/.cache/uv"
export UV_PYTHON_INSTALL_DIR="$PROJECT_ROOT/.cache/uv-python"
export UV_LINK_MODE=copy          # external volumes cannot hardlink across FS
export UV_PYTHON=3.13
# Never resolve an interpreter outside UV_PYTHON_INSTALL_DIR: without this, uv
# silently reuses a shared or Homebrew interpreter on another volume.
export UV_PYTHON_PREFERENCE=only-managed
export UV_PYTHON_DOWNLOADS=automatic
# `uv python install` / `uv tool install` otherwise drop shims into ~/.local/bin.
export UV_PYTHON_BIN_DIR="$UV_PYTHON_INSTALL_DIR/bin"
export UV_TOOL_DIR="$PROJECT_ROOT/.cache/uv-tools"
export UV_TOOL_BIN_DIR="$UV_TOOL_DIR/bin"
export PIP_CACHE_DIR="$PROJECT_ROOT/.cache/pip"

# ------------------------------ Tool caches --------------------------------- #
export RUFF_CACHE_DIR="$PROJECT_ROOT/.cache/ruff"
export MYPY_CACHE_DIR="$PROJECT_ROOT/.cache/mypy"
export COVERAGE_FILE="$PROJECT_ROOT/.cache/coverage/.coverage"
export TIKTOKEN_CACHE_DIR="$PROJECT_ROOT/.cache/tiktoken"
export XDG_CACHE_HOME="$PROJECT_ROOT/.cache/xdg"
# pytest tmp_path, tempfile, subprocess scratch: keep them on the SSD too.
export TMPDIR="$PROJECT_ROOT/.cache/tmp"

# ---------------------------- Model weight caches --------------------------- #
export HF_HOME="$PROJECT_ROOT/.cache/huggingface"
export HUGGINGFACE_HUB_CACHE="$HF_HOME/hub"
export HF_XET_CACHE="$HF_HOME/xet"
export TORCH_HOME="$PROJECT_ROOT/.cache/torch"
export HF_HUB_DISABLE_TELEMETRY=1

# ------------------------------- Runtime ------------------------------------ #
export PYTHONDONTWRITEBYTECODE=1

mkdir -p "$UV_CACHE_DIR" "$UV_PYTHON_INSTALL_DIR" "$UV_TOOL_DIR" "$HF_HOME" "$TMPDIR" \
  "${COVERAGE_FILE%/*}"

# --------------------------------------------------------------------------- #
# `layout uv` — direnv dispatches `layout <name>` to `layout_<name>`, so we
# define a uv-native layout instead of `layout python` (which would shell out
# to the system interpreter).
# --------------------------------------------------------------------------- #
layout_uv() {
  if [[ ! -d "$UV_PROJECT_ENVIRONMENT" ]]; then
    log_status "uv: creating virtualenv at ${UV_PROJECT_ENVIRONMENT#"$PROJECT_ROOT"/}"
    uv venv --quiet --python "$UV_PYTHON" "$UV_PROJECT_ENVIRONMENT"
  fi
  export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
  PATH_add "$VIRTUAL_ENV/bin"
}

layout uv

# ------------------------- Git attribution guard ---------------------------- #
# Versioned hooks in .githooks/ enforce the invariant documented in CLAUDE.md.
# Re-asserted on every `cd` so a fresh clone is guarded as soon as it is allowed.
if [[ "$(git config --local --get core.hooksPath 2>/dev/null)" != ".githooks" ]]; then
  git config --local core.hooksPath .githooks && log_status "git: attribution hooks installed"
fi

# Load secrets last so they win over anything above. `.env` stays git-ignored.
dotenv_if_exists "$PROJECT_ROOT/.env"

watch_file pyproject.toml uv.lock .env
