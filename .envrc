# direnv config — keeps every venv, cache and bytecode artefact on the external SSD.
# Defined inline (not in ~/.config/direnv/direnvrc) so nothing lives on the internal disk,
# and because direnv's stdlib does not ship `layout uv` in all versions.
if ! declare -F layout_uv >/dev/null; then
  layout_uv() {
    if [[ ! -d "$PWD/.venv" ]]; then
      uv venv --quiet "$PWD/.venv"
    fi
    export VIRTUAL_ENV="$PWD/.venv"
    PATH_add "$VIRTUAL_ENV/bin"
  }
fi

export UV_PROJECT_ENVIRONMENT="$PWD/.venv"
export UV_CACHE_DIR="$PWD/.cache/uv"
export UV_LINK_MODE="copy"
export HF_HOME="$PWD/.cache/huggingface"
export HUGGINGFACE_HUB_CACHE="$PWD/.cache/huggingface/hub"
export TORCH_HOME="$PWD/.cache/torch"
export XDG_CACHE_HOME="$PWD/.cache/xdg"
export PYTHONDONTWRITEBYTECODE=1

# Extra hardening: tool caches, tiktoken BPE files and tempfiles also stay on the SSD.
export RUFF_CACHE_DIR="$PWD/.cache/ruff"
export MYPY_CACHE_DIR="$PWD/.cache/mypy"
export TIKTOKEN_CACHE_DIR="$PWD/.cache/tiktoken"
export TMPDIR="$PWD/.cache/tmp"
mkdir -p "$TMPDIR"

layout uv

dotenv_if_exists .env
